  {
    "evidence": "d940c5adfedea3b4c0e801370bf24b296b9473eb6c3fa580d340f9c7983c50ef",
    "theorem": "Firth.Proofs.Programs.Division.gcd_contract",
    "module": "proofs.Programs.Division",
    "export": "Programs.Division",
    "word": "gcd",
    "contract": "Firth.Proofs.Programs.Division.gcdContract",
    "gamma": "Firth.Logic.int64Gamma",
    "costs": "Firth.Interpreter.defaultCosts",
    "claim": "For all a and b in i64 other than -2^63, gcd's body takes a b to their greatest common divisor within 22|b| + 33 steps at kernel cost at most 20|b| + 31 (a linear bound, looser than Euclid's logarithmic one), with no i64 overflow on the way.",
    "statement": {
      "args": "Prod Int Int",
      "pre": "fun args =>\n  And (Firth.Logic.InInt64 (Prod.fst args))\n    (And (Firth.Logic.InInt64 (HSub.hSub 0 (Prod.fst args)))\n      (And (Firth.Logic.InInt64 (Prod.snd args)) (Firth.Logic.InInt64 (HSub.hSub 0 (Prod.snd args)))))",
      "input": "fun args =>\n  List.cons (Firth.Interpreter.Value.literal (Firth.Interpreter.Literal.int (Prod.snd args)))\n    (List.cons (Firth.Interpreter.Value.literal (Firth.Interpreter.Literal.int (Prod.fst args))) List.nil)",
      "output": "fun args =>\n  List.cons\n    (Firth.Interpreter.Value.literal\n      (Firth.Interpreter.Literal.int (Nat.cast (Int.gcd (Prod.fst args) (Prod.snd args)))))\n    List.nil",
      "steps": "fun args => HAdd.hAdd (HMul.hMul 22 (Int.natAbs (Prod.snd args))) 33",
      "cost": "fun args => HAdd.hAdd (HMul.hMul 20 (Int.natAbs (Prod.snd args))) 31"},
    "statement_digest": "a2aa451ae055f7a97cc980886d5be729b7904a46fd955902b27f9773a9f2c30e",
    "axioms": ["Classical.choice", "Quot.sound", "propext"],
    "lean": "4.30.0",
