      "args": "Int",
      "pre": "fun x => Firth.Logic.InInt64 (HSub.hSub 0 x)",
      "input": "fun x => List.cons (Firth.Interpreter.Value.literal (Firth.Interpreter.Literal.int x)) List.nil",
      "output": "fun x => List.cons (Firth.Interpreter.Value.literal (Firth.Interpreter.Literal.int (Nat.cast (Int.natAbs x)))) List.nil",
      "steps": "fun x => 16",
      "cost": "fun x => 15"},
    "statement_digest": "57e3348e8b615bc6e756aab700a4b2b616aa38cfee5bbc535557c36e319e3947",
