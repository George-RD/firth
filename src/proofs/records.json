  {
    "evidence": "a023d11b54d7cef1669563fb2702198994037970a88d70e7eef75438a8435292",
    "theorem": "Firth.Proofs.Programs.Division.divmod_contract",
    "module": "proofs.Programs.Division",
    "export": "Programs.Division",
    "word": "divmod",
    "contract": "Firth.Proofs.Programs.Division.divmodContract",
    "gamma": "Firth.Logic.int64Gamma",
    "costs": "Firth.Interpreter.defaultCosts",
    "claim": "For all integers a and b with b nonzero and the quotient a div b in i64, divmod's body takes a b to the Euclidean quotient and remainder (0 <= a mod b < |b|) in exactly 6 steps at kernel cost 6.",
    "statement": {
      "args": "Prod Int Int",
      "pre": "fun args => And (Ne (Prod.snd args) 0) (Firth.Logic.InInt64 (HDiv.hDiv (Prod.fst args) (Prod.snd args)))",
      "input": "fun args =>\n  List.cons (Firth.Interpreter.Value.literal (Firth.Interpreter.Literal.int (Prod.snd args)))\n    (List.cons (Firth.Interpreter.Value.literal (Firth.Interpreter.Literal.int (Prod.fst args))) List.nil)",
      "output": "fun args =>\n  List.cons\n    (Firth.Interpreter.Value.literal (Firth.Interpreter.Literal.int (HMod.hMod (Prod.fst args) (Prod.snd args))))\n    (List.cons\n      (Firth.Interpreter.Value.literal (Firth.Interpreter.Literal.int (HDiv.hDiv (Prod.fst args) (Prod.snd args))))\n      List.nil)",
      "steps": "fun x => 6",
      "cost": "fun x => 6"},
    "statement_digest": "1505d47777279f652129942ec9b27b77a48bbfbb8f8658c54e5b8efc6a306e5a",
    "axioms": ["Classical.choice", "Quot.sound", "propext"],
