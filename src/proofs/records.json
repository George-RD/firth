      "output": "fun n =>\n  List.cons (Firth.Interpreter.Value.literal (Firth.Interpreter.Literal.int (Firth.Proofs.Programs.SumTo.triangle n)))\n    List.nil",
      "steps": "fun n => HAdd.hAdd (HMul.hMul 14 n) 10",
      "cost": "fun n => HAdd.hAdd (HMul.hMul 13 n) 10"},
    "statement_digest": "006cd31b550623fc5915568d582adb9a1acdfc8e754107e5127f12e93a935cb7",
