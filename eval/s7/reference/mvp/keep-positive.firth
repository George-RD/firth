: keep-from
  (forall ρ; ρ xs:Seq Int^many out:Seq Int^many i:Int^many -- ρ r:Seq Int^many)
  locals { xs out i }
  { i xs prim seq-int.len prim <
    [ xs
      0 xs i prim seq-int.at prim <
      [ out xs i prim seq-int.at prim seq-int.push ] [ out ] if
      i 1 prim + keep-from ]
    [ out ] if };

: main
  (forall ρ; ρ xs:Seq Int^many -- ρ positives:Seq Int^many)
  prim seq-int.empty 0 keep-from;
