: dot-from
  (forall ρ; ρ xs:Seq Int^many ys:Seq Int^many acc:Int^many i:Int^many -- ρ r:Int^many)
  locals { xs ys acc i }
  { i xs prim seq-int.len prim <
    [ xs ys
      acc xs i prim seq-int.at ys i prim seq-int.at prim * prim +
      i 1 prim + dot-from ]
    [ acc ] if };

: main
  (forall ρ; ρ xs:Seq Int^many ys:Seq Int^many -- ρ product:Int^many)
  0 0 dot-from;
