+  | dip {span : Span} {state : State} :
+      ErasesAtomTo "dip" span state (atomList .dip span) state
   | call {span : Span} {state : State} :
       ErasesAtomTo "call" span state (atomList .call span) state
   | compose {span : Span} {state : State} :
